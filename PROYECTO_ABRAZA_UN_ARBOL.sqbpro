><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="PLANTA" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="73"/><column index="2" value="109"/><column index="3" value="117"/><column index="4" value="78"/><column index="5" value="108"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="sqlite_sequence" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="39"/><column index="2" value="29"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">--CREACION DE TABLA 1 CON RESTRICCIONES (DDL)
CREATE TABLE PLANTA (ID_PLANTA INTEGER PRIMARY KEY AUTOINCREMENT, ESPECIE TEXT NOT NULL, ALTURA TEXT NOT NULL, RAIZ TEXT NOT NULL, 
ID_INSTITUCION INTEGER, FOREIGN KEY (ID_INSTITUCION) REFERENCES INSTITUCION (ID_INSTITUCION));

--INSERCION DE DATOS (DML)
INSERT INTO PLANTA (ESPECIE, ALTURA, RAIZ, ID_INSTITUCION)
VALUES ('Trueno', '3 a 10 metros', 'Pivotante', '55');
