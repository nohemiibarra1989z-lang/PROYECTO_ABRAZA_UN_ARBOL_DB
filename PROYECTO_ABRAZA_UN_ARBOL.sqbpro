VALUES ('Fresno', '15 a 20 metros', 'Pivotante', '92');
INSERT INTO PLANTA (ESPECIE, ALTURA, RAIZ, ID_INSTITUCION)
VALUES ('Trueno', '3 a 10 metros', 'Pivotante', '22');

--CONSULTAS BASICAS DE VERIFICACION (DML)
SELECT * FROM PLANTA ;
SELECT * FROM PLANTA WHERE ALTURA &lt;=3;
SELECT * FROM PLANTA WHERE ESPECIE = 'Trueno';

--INNER JOIN

SELECT PLANTA.ESPECIE AS 'NOMBRE PLANTA',
INSTITUCION.DIRECCION
FROM PLANTA
INNER JOIN INSTITUCION ON PLANTA.ID_INSTITUCION=INSTITUCION.ID_INSTITUCION;

SELECT BENEFICIARIO.NOMBRE  AS 'NOMBRE BENEFICIARIO',
PLANTA.ESPECIE
FROM BENEFICIARIO
INNER JOIN PLANTA ON BENEFICIARIO.ID_PLANTA=PLANTA.ID_PLANTA;

--GRUPO BY 

SELECT ALTURA, COUNT (*) AS TOTAL
FROM PLANTA
GROUP BY ALTURA ;

SELECT ESPECIE, COUNT(*) AS TOTAL
FROM PLANTA
GROUP BY ESPECIE ;

--CONSULTA COMBINADA INNER JOIN Y GRUPO BY 

SELECT PLANTA.ESPECIE ,
COUNT (BENEFICIARIO.ID_BENEFICIARIO ) AS TOTAL_BENEFICIARIO
FROM  BENEFICIARIO
INNER JOIN PLANTA
ON BENEFICIARIO.ID_PLANTA = PLANTA.ID_PLANTA
GROUP BY PLANTA.ESPECIE ;





--CREACION DE TABLA 2 CON RESTRICCIONES (DDL)
CREATE TABLE BENEFICIARIO (ID_BENEFICIARIO TEXT PRIMARY KEY, NOMBRE TEXT NOT NULL, DIRECCION TEXT, TELEFONO TEXT,
ID_PLANTA TEXT INTEGER, FOREIGN KEY (ID_PLANTA) REFERENCES PLANTA (ID_PLANTA));


